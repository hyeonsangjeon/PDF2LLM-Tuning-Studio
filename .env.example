# .env — copy to `.env` and fill in. Generated from pdf_qa/settings.yaml
# Regenerate: python -m pdf_qa.settings --write-env .env.example

# ===== Core =====
# Backend to use: azure | bedrock | openai | ollama (and aliases).
LLM_PROVIDER=azure
# Subject domain injected into the persona prompts.
DOMAIN=International Finance
# Q&A persona/method: professor, socratic, consultant, interviewer, analyst, feynman, memoirist.
PERSONA=professor
# Path to a custom persona YAML ledger (overrides the bundled personas.yaml).
# PERSONA_FILE=
# Questions to generate per text chunk.
NUM_QUESTIONS=5
# Questions to generate per figure/chart.
NUM_IMG_QUESTIONS=1
# Generic model/deployment id; each provider falls back to its own default.
# MODEL_ID=

# ===== Extraction / chart-context =====
# unstructured strategy: auto | fast | hi_res | ocr_only (auto escalates to hi_res on GPU or when a layout model is set).
STRATEGY=auto
# Route the heavy layout + table models to the GPU when one is detected.
GPU_BOOST=true
# Layout-detection model for the hi_res path (yolox | yolox_quantized | detectron2_onnx ...). Passed to unstructured as hi_res_model_name.
#   aliases: HI_RES_MODEL_NAME, UNSTRUCTURED_HI_RES_MODEL_NAME
# TABLE_MODEL=
# Directory where extracted figure/chart crops are written.
FIGURES_DIR=figures
# 1 = also send table crops to the vision model (default off: table text is richer).
# EXTRACT_TABLE_IMAGES=
# 1 = force the old context-free image path (glob crops off disk instead of the ordered figure<->context linkage).
# LEGACY_IMAGE_GLOB=
# Max characters of surrounding text attached to each figure as context.
FIGURE_CONTEXT_MAX_CHARS=800
# Max preceding paragraphs pulled into a figure's context.
FIGURE_CONTEXT_MAX_ELEMS=3
# Max following paragraphs/caption pulled into a figure's context.
FIGURE_CONTEXT_AFTER_ELEMS=2
# Hard character budget per text chunk.
TEXT_CHUNK_MAX_CHARS=4000
# Prefer to break a text chunk at a section heading once it reaches this size.
TEXT_CHUNK_SOFT_LIMIT=3800

# ===== Input / output (local + batch) =====
# Input PDF for run_local.py.
PDF_PATH=data/fsi_data.pdf
# Output JSONL for run_local.py.
OUTPUT_PATH=data/qa_pairs.jsonl
# Override path to the bundled demo PDF used by the web app.
# SAMPLE_PDF=
# Batch mode: folder scanned for *.pdf (run_auto.py).
INPUT_DIR=/data/input
# Batch mode: folder where per-file JSONL + manifest are written.
OUTPUT_DIR=/data/output
# 1 = reprocess batch inputs even if their output already exists.
# OVERWRITE=

# ===== Provider: Azure AI Foundry (Entra ID first-class) =====
# Azure OpenAI endpoint, e.g. https://<resource>.openai.azure.com/ (required for the azure provider).
#   required for: azure
# AZURE_OPENAI_ENDPOINT=
# API key. LEAVE UNSET for keyless Entra ID (DefaultAzureCredential) — the recommended path.
# AZURE_OPENAI_API_KEY=
# Azure OpenAI deployment name.
AZURE_OPENAI_DEPLOYMENT=gpt-4o
# Azure OpenAI API version.
#   aliases: OPENAI_API_VERSION
AZURE_OPENAI_API_VERSION=2024-10-21
# Entra ID token audience for keyless auth.
AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# azure backend: openai (Azure OpenAI) or agent (Foundry Agent Service).
AZURE_MODE=openai
# Foundry project endpoint (AZURE_MODE=agent only).
#   aliases: PROJECT_ENDPOINT
# AZURE_AI_PROJECT_ENDPOINT=
# Model deployment for the Foundry Agent (AZURE_MODE=agent only).
AZURE_AI_AGENT_MODEL=gpt-4o

# ===== Provider: OpenAI =====
# OpenAI API key (required for the openai provider).
#   required for: openai
# OPENAI_API_KEY=
# OpenAI multimodal model.
OPENAI_MODEL=gpt-4o

# ===== Provider: AWS Bedrock =====
# AWS region for Bedrock runtime.
AWS_REGION=us-east-1
# AWS access key. Unset = boto3 default chain (role/profile).
# AWS_ACCESS_KEY_ID=
# AWS secret key (with AWS_ACCESS_KEY_ID).
# AWS_SECRET_ACCESS_KEY=
# Optional AWS session token for temporary credentials.
# AWS_SESSION_TOKEN=

# ===== Provider: Ollama (local, no credentials) =====
# Local Ollama model tag (e.g. llama3.1, llava for vision).
OLLAMA_MODEL=llama3.1
# Ollama server URL.
#   aliases: OLLAMA_HOST
OLLAMA_BASE_URL=http://localhost:11434

# ===== Web app =====
# Web app bind host.
HOST=0.0.0.0
# Web app port.
PORT=8000
# 1 = single-node in-process (GPU demo); N = multi-process CPU concurrency.
WORKERS=1
