# syntax=docker/dockerfile:1
# PDF2LLM-Tuning-Studio - GPU PDF Q&A extraction image (restricted-network build)
# Same lightweight multi-stage design as Dockerfile, but with apt retry/timeout
# tuning for AWS Event Engine lab accounts that have flaky egress.
#
# See Dockerfile for the full size-strategy rationale (cuda:base + pip-bundled
# torch CUDA libs + multi-stage). Override the base with:
#   docker build --build-arg CUDA_TAG=12.4.1-runtime-ubuntu22.04 -f Dockerfile_event_eng .

# ============================  Stage 1: builder  ============================
ARG CUDA_TAG=12.4.1-base-ubuntu22.04
FROM nvidia/cuda:${CUDA_TAG} AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Resilient apt settings for restricted networks (retries + long timeouts).
RUN echo 'Acquire::Retries "20";' > /etc/apt/apt.conf.d/80retries && \
    echo 'Acquire::http::Timeout "240";'  > /etc/apt/apt.conf.d/99timeout && \
    echo 'Acquire::https::Timeout "240";' >> /etc/apt/apt.conf.d/99timeout && \
    echo 'APT::Get::Assume-Yes "true";'   > /etc/apt/apt.conf.d/90assumeyes && \
    echo 'APT::Get::Fix-Missing "true";'  > /etc/apt/apt.conf.d/90fixmissing

# Build toolchain + Python (Ubuntu 22.04 ships Python 3.10; no PPA needed).
RUN apt-get -o Dpkg::Options::="--force-confold" update && \
    apt-get -o Dpkg::Options::="--force-confold" install --fix-broken --fix-missing -y \
        --no-install-recommends \
        python3 python3-venv python3-dev \
        build-essential \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# A self-contained venv is copied wholesale into the runtime stage.
ENV VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:${PATH}"
RUN python3 -m venv "$VIRTUAL_ENV"

WORKDIR /build
COPY requirements.txt pyproject.toml README.md ./
COPY pdf_qa ./pdf_qa
RUN pip install --upgrade pip setuptools wheel && \
    pip install -r requirements.txt && \
    pip install --no-deps --no-build-isolation . && \
    find "$VIRTUAL_ENV" -type d -name __pycache__ -prune -exec rm -rf {} + || true

# ============================  Stage 2: runtime  ============================
ARG CUDA_TAG=12.4.1-base-ubuntu22.04
FROM nvidia/cuda:${CUDA_TAG}

ENV DEBIAN_FRONTEND=noninteractive \
    VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1

RUN echo 'Acquire::Retries "20";' > /etc/apt/apt.conf.d/80retries && \
    echo 'Acquire::http::Timeout "240";'  > /etc/apt/apt.conf.d/99timeout && \
    echo 'Acquire::https::Timeout "240";' >> /etc/apt/apt.conf.d/99timeout && \
    echo 'APT::Get::Assume-Yes "true";'   > /etc/apt/apt.conf.d/90assumeyes && \
    echo 'APT::Get::Fix-Missing "true";'  > /etc/apt/apt.conf.d/90fixmissing

# Runtime-only shared libraries (OCR / PDF raster / OpenCV native deps).
RUN apt-get -o Dpkg::Options::="--force-confold" update && \
    apt-get -o Dpkg::Options::="--force-confold" install --fix-broken --fix-missing -y \
        --no-install-recommends \
        python3 \
        tesseract-ocr \
        poppler-utils \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libmagic1 \
        libsm6 \
        libxext6 \
        libxrender1 && \
    rm -rf /var/lib/apt/lists/*

# Bring in the fully-installed environment (pdf_qa + all provider SDKs).
COPY --from=builder /opt/venv /opt/venv

WORKDIR /app
COPY run_local.py processing.py azureml_job.py ./
COPY processing_local.py processing_local_openai.py ./

# LLM_PROVIDER env var selects the backend (azure | bedrock | openai).
CMD ["python", "run_local.py"]
