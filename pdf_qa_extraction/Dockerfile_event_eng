# syntax=docker/dockerfile:1
# PDF2LLM-Tuning-Studio - PDF Q&A extraction image (restricted-network build)
# Same slim CPU multi-stage design as Dockerfile, but with apt retry/timeout
# tuning for AWS Event Engine lab accounts that have flaky egress.
#
# See Dockerfile for the full size rationale (CPU-only torch + slim base +
# multi-stage). Optional GPU build (CUDA torch + onnxruntime-gpu, run --gpus all):
#   docker build \
#     --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cu124 \
#     --build-arg ONNXRUNTIME_PACKAGE=onnxruntime-gpu \
#     -f Dockerfile_event_eng .

# ============================  Stage 1: builder  ============================
ARG PYTHON_TAG=3.10-slim-bookworm
FROM python:${PYTHON_TAG} AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DEBIAN_FRONTEND=noninteractive

# Resilient apt settings for restricted networks (retries + long timeouts).
RUN echo 'Acquire::Retries "20";' > /etc/apt/apt.conf.d/80retries && \
    echo 'Acquire::http::Timeout "240";'  > /etc/apt/apt.conf.d/99timeout && \
    echo 'Acquire::https::Timeout "240";' >> /etc/apt/apt.conf.d/99timeout && \
    echo 'APT::Get::Assume-Yes "true";'   > /etc/apt/apt.conf.d/90assumeyes && \
    echo 'APT::Get::Fix-Missing "true";'  > /etc/apt/apt.conf.d/90fixmissing

# Compilers/headers for the few deps that lack prebuilt manylinux wheels
# (builder-stage only, never shipped in the final image).
RUN apt-get -o Dpkg::Options::="--force-confold" update && \
    apt-get -o Dpkg::Options::="--force-confold" install --fix-broken --fix-missing -y \
        --no-install-recommends \
        build-essential \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

ENV VIRTUAL_ENV=/opt/venv PATH="/opt/venv/bin:${PATH}"
RUN python -m venv "$VIRTUAL_ENV"

# CPU-only torch keeps the image ~3.5GB smaller than the default CUDA wheel.
# Point this at .../whl/cu124 (and run with --gpus all) for a GPU build.
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
# GPU build overrides this with `onnxruntime-gpu` so the ONNX layout models
# (YOLOX / detectron2_onnx) use the CUDAExecutionProvider too.
ARG ONNXRUNTIME_PACKAGE=onnxruntime

WORKDIR /build
COPY requirements.txt pyproject.toml README.md ./
COPY pdf_qa ./pdf_qa
RUN pip install --upgrade pip setuptools wheel && \
    pip install --index-url "${TORCH_INDEX_URL}" torch && \
    pip install -r requirements.txt && \
    pip install --no-deps --no-build-isolation . && \
    if [ "${ONNXRUNTIME_PACKAGE}" != "onnxruntime" ]; then \
        pip uninstall -y onnxruntime && \
        pip install "${ONNXRUNTIME_PACKAGE}"; \
    fi && \
    find "$VIRTUAL_ENV" -type d -name __pycache__ -prune -exec rm -rf {} + || true

# ============================  Stage 2: runtime  ============================
ARG PYTHON_TAG=3.10-slim-bookworm
FROM python:${PYTHON_TAG}

ENV VIRTUAL_ENV=/opt/venv \
    PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

RUN echo 'Acquire::Retries "20";' > /etc/apt/apt.conf.d/80retries && \
    echo 'Acquire::http::Timeout "240";'  > /etc/apt/apt.conf.d/99timeout && \
    echo 'Acquire::https::Timeout "240";' >> /etc/apt/apt.conf.d/99timeout && \
    echo 'APT::Get::Assume-Yes "true";'   > /etc/apt/apt.conf.d/90assumeyes && \
    echo 'APT::Get::Fix-Missing "true";'  > /etc/apt/apt.conf.d/90fixmissing

# Runtime-only shared libraries (OCR / PDF raster / OpenCV native deps /
# OpenMP / libmagic). No compilers, no CUDA.
RUN apt-get -o Dpkg::Options::="--force-confold" update && \
    apt-get -o Dpkg::Options::="--force-confold" install --fix-broken --fix-missing -y \
        --no-install-recommends \
        tesseract-ocr \
        poppler-utils \
        libglib2.0-0 \
        libgl1 \
        libgomp1 \
        libmagic1 \
        libsm6 \
        libxext6 \
        libxrender1 && \
    rm -rf /var/lib/apt/lists/*

# Bring in the fully-installed environment (pdf_qa + all provider SDKs).
COPY --from=builder /opt/venv /opt/venv

# Make the venv's bundled NVIDIA CUDA/cuDNN libs discoverable by the loader so
# onnxruntime-gpu can load its CUDAExecutionProvider (GPU build). No-op for CPU.
RUN find /opt/venv -type d \( -path '*/nvidia/*/lib' -o -path '*/torch/lib' \) \
        > /etc/ld.so.conf.d/venv-cuda.conf 2>/dev/null || true; \
    ldconfig

WORKDIR /app
COPY run_local.py processing.py azureml_job.py ./
COPY processing_local.py processing_local_openai.py ./

# LLM_PROVIDER env var selects the backend (azure | bedrock | openai).
CMD ["python", "run_local.py"]
